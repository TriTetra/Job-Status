#!/usr/bin/env python
"""CareerOS CLI launcher — sets UTF-8 encoding on Windows and delegates to apps.cli.main."""
import os
import sys

# Force UTF-8 so Rich/Typer renders box-drawing chars on Windows cp1252 terminals
os.environ.setdefault("PYTHONUTF8", "1")

sys.path.insert(0, os.path.dirname(__file__))

from apps.cli.main import app

if __name__ == "__main__":
    app()
