# config.yaml.example
# ====================
# Bu dosyayi config.yaml olarak kopyala ve degerleri doldur.
# API key'i config.yaml'a YAZMA -- .env dosyasina yaz.
#
# cp config.yaml.example config.yaml

llm:
  provider: openrouter
  api_key: ${OPENROUTER_API_KEY}
  base_url: https://openrouter.ai/api/v1
  model: openai/gpt-4o-mini

job_search:
  location: Remote
  remote_only: true
  hours_old: 72
  results_per_site: 50
  min_score: 8

candidate:
  name: "Your Name"
  email: "your.email@example.com"
  phone: "+1234567890"
  city: "Your City"
  country: "Your Country"
  linkedin: "https://linkedin.com/in/yourprofile"
  github: "https://github.com/yourusername"
  current_title: "ML Engineer"
  years_experience: 2
  salary_min: 40000
  salary_max: 80000
  currency: USD
  work_authorized: false
  needs_sponsorship: true

  core_skills:
    - Python
    - PyTorch
    - React

  target_roles:
    - ML Engineer
    - Backend Engineer

  avoid:
    - Senior
    - Lead

resume:
  preserve_companies: []
  preserve_projects: []
  preserve_metrics: []
