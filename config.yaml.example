# config.yaml.example
# ====================
# Bu dosyayi config.yaml olarak kopyala ve degerleri doldur.
# API key'i config.yaml'a YAZMA -- .env dosyasina yaz.
#
# cp config.yaml.example config.yaml

llm:
  provider: openrouter
  api_key: ${OPENROUTER_API_KEY}
  base_url: https://openrouter.ai/api/v1
  model: openai/gpt-4o-mini

job_search:
  location: Remote
  remote_only: true
  hours_old: 72
  results_per_site: 50
  min_score: 8

candidate:
  name: "Your Name"
  email: "your.email@example.com"
  phone: "+1234567890"
  city: "Your City"
  country: "Your Country"
  linkedin: "https://linkedin.com/in/yourprofile"
  github: "https://github.com/yourusername"
  current_title: "ML Engineer"
  years_experience: 2
  salary_min: 40000
  salary_max: 80000
  currency: USD
  work_authorized: false
  needs_sponsorship: true

  core_skills:
    - Python
    - PyTorch
    - React

  # Skill proficiency — optional, falls back to WORKING/0.6 if omitted.
  # level: AI_ASSISTED | WORKING | INDEPENDENT | ADVANCED | EXPERT
  # ai_multiplier: 0.0–1.0 (how much you rely on AI for this skill)
  # evidence: list of proof strings (shown in explanations)
  skill_profiles:
    Python:
      level: INDEPENDENT
      ai_multiplier: 0.8
      evidence: ["Multiple production projects"]
    PyTorch:
      level: WORKING
      ai_multiplier: 0.7
      evidence: ["Fine-tuned models, custom pipelines"]
    React:
      level: AI_ASSISTED
      ai_multiplier: 0.3
      evidence: []

  target_roles:
    - ML Engineer
    - Backend Engineer

  avoid:
    - Senior
    - Lead

resume:
  preserve_companies: []
  preserve_projects: []
  preserve_metrics: []
