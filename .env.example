# ApplyPilot Environment Variables
# ================================
# Copy this file to ~/.applypilot/.env and fill in your values

# OpenRouter API (or OpenAI)
LLM_URL=https://openrouter.ai/api/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=openai/gpt-4o-mini

# Alternative: Direct OpenAI
# LLM_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# Alternative: Anthropic Claude
# LLM_MODEL=anthropic/claude-3-5-haiku-20241022
# LLM_MODEL=anthropic/claude-sonnet-4-6

# Optional: Gemini (has rate limits)
# GEMINI_API_KEY=your-gemini-key
# LLM_MODEL=gemini-2.0-flash

# ══ CareerOS ═══════════════════════════════════════════════════════════════
# Every variable below is read in exactly one place: shared/config.py (Settings).

# ── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://career_os:<password>@localhost:5432/career_os
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=30
# DB_ECHO=false

# ── LLM (shared/llm.py — OpenRouter-compatible chat completions) ───────────
OPENROUTER_API_KEY=sk-or-...
# DEFAULT_MODEL=openai/gpt-4o-mini
# LLM_BASE_URL=https://openrouter.ai/api/v1

# ── GitHub ─────────────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_...            # evidence enrichment
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/oauth/github/callback

# ── Tokens at rest ─────────────────────────────────────────────────────────
TOKEN_ENCRYPTION_KEY=           # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CLERK_JWKS_URL=https://<your-instance>.clerk.accounts.dev/.well-known/jwks.json

# ── Web app ────────────────────────────────────────────────────────────────
# WEB_APP_URL=http://localhost:3000      # where OAuth callbacks send the browser back

# ── Logging ────────────────────────────────────────────────────────────────
# LOG_LEVEL=INFO

# ── CareerOS API auth ──────────────────────────────────────────────────────
# Clerk webhook signing secret (Dashboard → Webhooks → endpoint → Signing secret).
# Required: without it POST /api/webhooks/clerk answers 503 (fails closed).
CLERK_WEBHOOK_SECRET=whsec_...

# Local e2e scripts only (tests/manual): lets `X-User-Id: user_e2e_*` act as a
# user without a Clerk token. NEVER set this in a deployed environment.
# CAREEROS_E2E_AUTH_BYPASS=1
