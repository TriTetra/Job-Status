# ApplyPilot Environment Variables
# ================================
# Copy this file to ~/.applypilot/.env and fill in your values

# OpenRouter API (or OpenAI)
LLM_URL=https://openrouter.ai/api/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=openai/gpt-4o-mini

# Alternative: Direct OpenAI
# LLM_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# Alternative: Anthropic Claude
# LLM_MODEL=anthropic/claude-3-5-haiku-20241022
# LLM_MODEL=anthropic/claude-sonnet-4-6

# Optional: Gemini (has rate limits)
# GEMINI_API_KEY=your-gemini-key
# LLM_MODEL=gemini-2.0-flash

# ══ CareerOS ═══════════════════════════════════════════════════════════════
# Every variable below is read in exactly one place: shared/config.py (Settings).

# ── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://career_os:<password>@localhost:5432/career_os
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_CONNECT_TIMEOUT=5          # seconds; fail fast if the DB is unreachable
# DB_POOL_TIMEOUT=30
# DB_ECHO=false

# ── LLM (shared/llm.py — OpenRouter-compatible chat completions) ───────────
# Claude directly (preferred): interactive tasks on claude-opus-5-5, bulk on claude-haiku-5-5
# ANTHROPIC_API_KEY=sk-ant-...
# Or any OpenRouter-compatible API (used when no Anthropic key is set)
OPENROUTER_API_KEY=sk-or-...
# LLM_PROVIDER=anthropic            # anthropic | openrouter; default: whichever key is set
# DEFAULT_MODEL=                     # empty = provider default (claude-opus-5-5 / openai/gpt-4o-mini)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# Bulk work (reading job postings) can use a cheaper model; per-task overrides: task=model,…
# LLM_FAST_MODEL=openai/gpt-4o-mini
# LLM_TASK_MODELS=reasoning=anthropic/claude-3.5-haiku
# Daily caps in USD (reset 00:00 UTC; 0 = no cap). Bulk tasks stop at BULK_SHARE of the daily cap.
# LLM_DAILY_BUDGET_USD=2.0
# LLM_USER_DAILY_BUDGET_USD=0.5
# LLM_BULK_BUDGET_SHARE=0.7
# LLM_MAX_CONCURRENCY=4

# ── GitHub ─────────────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_...            # optional: GitHub public-profile reads 60 → 5 000 req/hour
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=            # default: ${WEB_APP_URL}/api/oauth/github/callback

# ── Tokens at rest ─────────────────────────────────────────────────────────
TOKEN_ENCRYPTION_KEY=           # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# ── Web app ────────────────────────────────────────────────────────────────
# WEB_APP_URL=http://localhost:3000      # where OAuth callbacks send the browser back

# ── Company job boards ─────────────────────────────────────────────────────
# Full refresh (every board, rescoring, mailboxes, kits, daily report) every N hours,
# and in between a tick every JOB_TICK_MINUTES (due boards, new matches to Telegram).
# Production: the `worker` service runs them as short-lived processes
# (`career-os jobs run`) and the API has this at 0. Local development: set it here and
# the API runs them in a thread. 0 = off; run `career-os jobs run` yourself.
# JOB_SYNC_INTERVAL_HOURS=6
# JOB_TICK_MINUTES=15
# glibc malloc arenas: 2 keeps threaded Python processes much smaller (set in the image too)
# MALLOC_ARENA_MAX=2

# ── Logging ────────────────────────────────────────────────────────────────
# LOG_LEVEL=INFO

# ── Sign-in ────────────────────────────────────────────────────────────────
# Accounts are invite-only:  career-os user add you@example.com
# Session cookie is Secure (HTTPS-only) by default; set false for plain-http local dev.
SESSION_COOKIE_SECURE=false

# Web → API address (apps/web reads it at build time for the /api rewrite and
# for server-side fetches). Default http://localhost:8000.
# API_URL=http://localhost:8000

# Local e2e scripts only (tests/manual): lets `X-User-Id: user_e2e_*` act as a
# user without a session. NEVER set this in a deployed environment.
# CAREEROS_E2E_AUTH_BYPASS=1

# ── Telegram notifications ──────────────────────────────────────────────
# Create a bot with @BotFather and paste its token. Users connect it in
# Settings → Connections; it sends new strong matches and follow-up reminders.
# The webhook is registered automatically when WEB_APP_URL is https.
# TELEGRAM_BOT_TOKEN=

# ── CLI ─────────────────────────────────────────────────────────────────
# Your account's e-mail: `career-os jobs scan`, `jobs eval` and `jobs eval-sheet`
# use it when you don't type one.
# CAREER_OS_EMAIL=you@example.com

# ── Adzuna job search API ───────────────────────────────────────────────
# Key at developer.adzuna.com. Adds jobs from Adzuna's country sites
# (GB, DE, NL, PL, ES, CH…) for the countries and roles users target.
# Each Adzuna job shows an "Adzuna" label linking to Adzuna (their terms).
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# Requests per read (feeds are read about twice a day). The paid plan allows
# 500 a day / 5,000 a month: 40 uses ~2,400 a month. Before activation the
# account has only 25 test calls in total: use 5 until then.
# ADZUNA_MAX_CALLS=40

# ── Companies House (UK company register) ──────────────────────────────
# Free key at developer.company-information.service.gov.uk (600 requests / 5 min).
# Adds status and incorporation date to company cards for UK employers.
# COMPANIES_HOUSE_API_KEY=
